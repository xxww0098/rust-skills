{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xxww0098/rust-skills/schemas/finding.schema.json",
  "title": "Finding",
  "type": "object",
  "required": [
    "id", "severity", "confidence", "scope", "location",
    "premise", "evidence", "counterevidence", "owner_layer",
    "minimal_fix", "verification"
  ],
  "properties": {
    "id": { "type": "string" },
    "rule_id": { "type": ["string", "null"] },
    "severity": { "enum": ["M", "S", "Y"] },
    "confidence": { "enum": ["high", "medium", "low"] },
    "scope": { "type": "string" },
    "location": { "type": "string" },
    "premise": { "type": "string" },
    "evidence": { "type": "string" },
    "counterevidence": { "type": "string" },
    "violated_invariant": { "type": "string" },
    "observable_effect": { "type": "string" },
    "owner_layer": { "type": "string" },
    "minimal_fix": { "type": "string" },
    "blast_radius": { "type": "string" },
    "compatibility_risk": { "type": "string" },
    "verification": { "type": "string" }
  }
}
